{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hrms-1-gaus.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    }
  ]
}
