# ==============================================================================
# HRMS Backend Environment Template (.env.example)
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Django Secret Key
SECRET_KEY=your-django-secret-key-change-this-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=*,localhost,127.0.0.1

# JWT Authentication Secrets (Must be at least 32 characters)
JWT_SECRET=your-jwt-signing-secret-key-at-least-32-chars
REFRESH_SECRET=your-jwt-refresh-secret-key-at-least-32-chars
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF Trusted Origins (comma-separated list)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Database URL (Leave commented out to use default local SQLite db.sqlite3)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
